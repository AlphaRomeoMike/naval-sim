# Copy to .env.production and fill in before `npm run build`. Nothing here is secret: it ships to the browser.

# Base URL of the deployed entitlement worker (server/), no trailing slash.
VITE_API_BASE=https://flagplot-entitlements.YOUR-ACCOUNT.workers.dev

# Hosted checkout links from your merchant of record, one per product. Leave one empty to show it as "not on sale".
VITE_CHECKOUT_US_LATE=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/VARIANT-UUID-1
VITE_CHECKOUT_USSR_LATE=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/VARIANT-UUID-2
VITE_CHECKOUT_FULL=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/VARIANT-UUID-3
